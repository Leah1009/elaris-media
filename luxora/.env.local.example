NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only, never sent to the browser. Bypasses RLS entirely — used
# solely by the Stripe webhook handler, which has no Supabase user session
# to act as (the request is authenticated by the Stripe signature instead).
SUPABASE_SERVICE_ROLE_KEY=

# Optional: set once the app has a real deployed domain, used to build
# Stripe onboarding return URLs. Falls back to the request host if unset.
NEXT_PUBLIC_APP_URL=

# Stripe — leave unset until a real Stripe account exists. Every
# Stripe-dependent code path checks for these and fails gracefully
# ("not connected yet") rather than crashing when they're absent.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
